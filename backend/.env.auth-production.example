# Private server configuration. Copy outside Git and fill on the server.
TAMAQ_ENV=production
TAMAQ_PROVIDER=openai
TAMAQ_DATABASE_URL=postgresql://tamaq:REPLACE@postgres:5432/tamaq
POSTGRES_PASSWORD=
TAMAQ_JWT_SECRET=
TAMAQ_SMTP_HOST=
TAMAQ_SMTP_PORT=587
TAMAQ_SMTP_STARTTLS=true
TAMAQ_SMTP_USERNAME=
TAMAQ_SMTP_PASSWORD=
TAMAQ_EMAIL_FROM=
TAMAQ_PROXY_IPS=127.0.0.1
# For the optional Caddy override on an existing server; no https:// prefix.
TAMAQ_DOMAIN=
TAMAQ_ACME_EMAIL=
TAMAQ_SMS_PROVIDER=disabled
TAMAQ_FILES_ROOT=/files
# Keep existing OPENAI_API_KEY, OPENAI_MODEL, PILOT_INVITE_TOKENS and budget values.
OPENAI_API_KEY=
OPENAI_MODEL=
PILOT_INVITE_TOKENS=
TAMAQ_GLOBAL_BUDGET_USD=50
TAMAQ_PILOT_BUDGET_USD=5
TAMAQ_VERIFICATION_BUDGET_USD=1
